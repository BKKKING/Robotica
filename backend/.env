# Firebase Configuration
FIREBASE_PROJECT_ID=robotica-project
FIREBASE_DATABASE_URL=https://robotica-project.firebaseio.com
FIREBASE_STORAGE_BUCKET=robotica-project.appspot.com

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=*
ALLOWED_METHODS=*
ALLOWED_HEADERS=*

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# App Configuration
APP_NAME=Robotica Control System
VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO